# Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Go to https://cloud.mongodb.com → Connect → Drivers → copy the string
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT secret — generate a random 64-char string
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe (optional — leave as-is if using UPI only)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# Your Render frontend URL (e.g. https://mega-mart-frontend.onrender.com)
FRONTEND_URL=https://your-frontend.onrender.com

# Payment redirect URLs (update with your Render frontend URL)
PAYMENT_SUCCESS_URL=https://your-frontend.onrender.com/payment-success
PAYMENT_CANCEL_URL=https://your-frontend.onrender.com/payment-cancel
